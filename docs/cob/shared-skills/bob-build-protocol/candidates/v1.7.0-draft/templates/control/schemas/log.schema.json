{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bob/control/log.schema.json",
  "title": "Work log",
  "description": "Every dated entry since the work began, back-filled on the framing pass to the first day of work and appended to in the same pass thereafter. Renders the control surface work-log page.",
  "type": "object",
  "required": ["program", "version", "entries"],
  "additionalProperties": false,
  "properties": {
    "program": {"type": "string"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{3}\\.[0-9]+$"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "date", "workstream", "what_was_done", "evidence", "source"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "date": {"type": "string", "description": "YYYY-MM-DD"},
          "time_zone": {"type": "string"},
          "started": {"type": ["string", "null"]},
          "finished": {"type": ["string", "null"]},
          "pass": {"type": ["integer", "null"]},
          "program_version": {"type": ["string", "null"]},
          "workstream": {"type": "string"},
          "units": {"type": "array", "items": {"type": "string"}},
          "what_was_done": {"type": "string"},
          "figures": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "value", "denominator"],
              "additionalProperties": false,
              "properties": {
                "label": {"type": "string"},
                "value": {"type": ["number", "string"]},
                "denominator": {"type": ["number", "string"]},
                "basis": {"type": "string", "enum": ["fact", "inference", "open_question"]}
              }
            }
          },
          "not_touched": {"type": "string", "description": "What this pass deliberately did not touch."},
          "found_along_the_way": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "source": {"type": "string", "enum": ["bob_pass", "back_filled_thread", "back_filled_commit", "back_filled_meeting", "back_filled_email", "back_filled_other"]},
          "predates_bob": {"type": "boolean"}
        }
      }
    }
  }
}
